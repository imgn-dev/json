<?xml version="1.0" encoding="UTF-8"?>
<!-- child.project.url.inherit.append.path: the attribute is not inherited from
     be.imgn.parent:parent once <url> is redefined here, so it is repeated;
     otherwise Maven appends each module's artifactId to the json URL. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.imgn.parent</groupId>
    <artifactId>parent</artifactId>
    <version>2026-11-01</version>
    <relativePath/>
  </parent>

  <groupId>be.imgn.json</groupId>
  <artifactId>json-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>JSON parent</name>
  <description>Build configuration shared by the JSON modules.</description>
  <!-- The parent's url and scm do not append child paths, so without these
       they would point at imgn-parent. -->
  <url>https://github.com/imgn-dev/json</url>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/imgn-dev/json.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/imgn-dev/json.git</developerConnection>
    <url>https://github.com/imgn-dev/json</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <!-- Published. -->
    <module>json</module>
    <module>json-processor</module>
    <!-- Not published: the JMH benchmarks, and the guide. -->
    <module>json-benchmarks</module>
    <module>json-docs</module>
  </modules>

  <properties>
    <!-- ${revision}, the one json version, is set in .mvn/maven.config rather
         than here, so that a release changes no POM. A release overrides it:
         -Drevision=1.2.3. -->

    <!-- Reproducible builds. A release sets it to the time of the commit it
         releases (-Dproject.build.outputTimestamp, in release.yml and
         scripts/release.sh); this value only serves other builds. -->
    <project.build.outputTimestamp>2026-11-17T00:00:00Z</project.build.outputTimestamp>

    <gaia.version>0.1.2</gaia.version>

    <flatten-maven-plugin.version>1.9.0</flatten-maven-plugin.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Only the modules that run something with exec turn it on: json-benchmarks, so that the reactor
             can build what the benchmarks need and run them in one command, and json-docs, which generates
             the guide. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <configuration>
            <skip>true</skip>
            <!-- Checked before skip is. -->
            <executable>java</executable>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Replaces ${revision} in the installed and deployed POMs. This
           configuration is for json-parent itself, which is published as a
           parent: only the CI-friendly properties are resolved and everything
           else, build configuration included, is kept. Library modules switch
           to the flatten-library-poms profile below. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
          <outputDirectory>${project.build.directory}</outputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Library POMs keep their parent chain (json-parent and
         be.imgn.parent:parent are both on Central), with ${revision} resolved.
         Their dependencies are flattened: written with concrete versions, and
         without the test-scoped ones, which mean nothing to a user. Activated
         the way the parent activates Checkstyle, by the presence of Java
         sources, so it never applies to json-parent. (resolveCiFriendliesOnly
         cannot be combined with flattened dependencies: flatten 1.8.0 fails
         with a NullPointerException in CiModelInterpolator.) -->
    <profile>
      <id>flatten-library-poms</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/java</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <configuration>
              <flattenMode>defaults</flattenMode>
              <pomElements>
                <parent>interpolate</parent>
                <name>interpolate</name>
                <description>interpolate</description>
                <dependencies>flatten</dependencies>
              </pomElements>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
